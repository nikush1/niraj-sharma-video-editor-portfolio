# Direct enquiry delivery uses the Resend email API.
# Create an API key with Resend and verify the sending domain before configuring these.
# Keep both values server-side; do not use a NEXT_PUBLIC_ prefix.
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL="Niraj Visuals <website@nirajvisuals.in>"
#
# Until these values are configured, the form reports that delivery is unavailable
# and keeps the email/WhatsApp fallbacks available.

# Optional verification values from your own search console accounts.
# Copy only the supplied verification token, not an HTML tag. Rebuild/redeploy after setting.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
